{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "quick",
  "description": "Read, copy and explicitly export cards from the quick panel.",
  "windows": ["quick"],
  "platforms": ["windows", "macOS"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-library",
    "allow-show-manager",
    "allow-hide-quick-panel",
    "allow-copy-text",
    "allow-save-text-file"
    ,"allow-get-account-session"
    ,"allow-get-dashboard"
    ,"allow-get-account-summary"
  ]
}
