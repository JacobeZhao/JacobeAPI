{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.jacobe.skills",
  "app": {
    "macOSPrivateApi": true
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
